# Template moonraker.conf for a BioKalico host. Copy this to
# ~/printer_data/config/moonraker.conf and adjust as needed - see
# QUICKSTART.md for the full walkthrough.

[server]
host: 0.0.0.0
port: 7125
klippy_uds_address: ~/printer_data/comms/klippy.sock

[authorization]
trusted_clients:
    192.168.0.0/16
    10.0.0.0/8
    127.0.0.0/8
    169.254.0.0/16
    172.16.0.0/12
    FC00::/7
    FE80::/10
    ::1/128
cors_domains:
    *.lan
    *.local
    *://localhost
    *://localhost:*
    *://my.mainsail.xyz
    *://app.fluidd.xyz

[octoprint_compat]

[history]

[update_manager]
channel: dev
refresh_interval: 168

# Single entry for the whole BioKalico stack: Moonraker git-pulls this repo,
# then runs scripts/biokalico-installer.sh (install_script), which syncs Moonraker,
# Mainsail, mainsail-config, and crowsnest in turn. See scripts/biokalico-installer.sh
# and biokalico_extras/README.md.
[update_manager klipper]
type: git_repo
path: ~/klipper
origin: https://github.com/nicholas-karr/BioKalico.git
primary_branch: main
managed_services: klipper
install_script: scripts/biokalico-installer.sh

# Registers $HOME as a selectable root in Mainsail's Config Files page.
[include ../../klipper/biokalico_extras/moonraker/moonraker_home_root.conf]

# Firmware build/flash panel backend - see biokalico_extras/firmware_flash.md.
[include ../../klipper/biokalico_extras/moonraker/moonraker_firmware_build.conf]

# "Restart All" button backend - see biokalico_extras/README.md.
[include ../../klipper/biokalico_extras/moonraker/moonraker_printer_services.conf]

# Deletes old heartbeats used by the multi-user warning - see
# biokalico_extras/README.md.
[include ../../klipper/biokalico_extras/moonraker/moonraker_presence_prune.conf]

# Automatic recovery from a Klipper MCU shutdown and, if configured, a
# dropped projector serial link - see biokalico_extras/README.md.
[include ../../klipper/biokalico_extras/moonraker/moonraker_auto_recovery.conf]

# Per-print timelapse, off by default - see biokalico_extras/README.md.
[include ../../klipper/biokalico_extras/moonraker/moonraker_timelapse.conf]

# One shared password for Mainsail, the only way to log in - see
# biokalico_extras/README.md.
[simple_password_auth]
# Leave blank to generate a random password on first run. It is written
# back into this line, so open this file again afterward to see it.
password:
# True (default): requests from trusted_clients above skip the password
# unless they came through a Cloudflare Tunnel. False: every request needs
# the password. Set False on a network shared with people who should not
# control the printer.
local_bypass: True
# Optional reminder text shown on Mainsail's login screen.
hint: ""
