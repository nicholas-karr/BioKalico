# Preset: rp2040_nitehawk_sb
#
# LDO Nitehawk SB toolhead board (RP2040). Confirmed with the user and
# LDO's own docs (https://docs.ldomotors.com/en/Toolboard/nitehawk-sb):
# Katapult is flashed as a first-stage bootloader at a 16KiB
# application-start offset (RPXXXX_FLASH_START_4000 -> 0x10004000).
# LDO's docs are explicit: get this offset wrong and you erase Katapult -
# see biokalico_extras/firmware_flash.md. USB serial, matching this
# printer's [mcu nhk] connection.
#
# Minimized with scripts/firmware/minimize_config.py. Note the "128KiB
# bootloader"-equivalent default for STM32H743 in stm32h743_mainboard.config
# doesn't apply here - RP2040's bootloader-offset default is "no bootloader",
# so RPXXXX_FLASH_START_4000 is a real, necessary override, unlike the STM32
# case.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_RPXXXX_FLASH_START_4000=y
