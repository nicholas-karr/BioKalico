# Preset: rp2040_skr_pico
#
# BIGTREETECH SKR Pico V1.0 (RP2040, W25Q16JV flash), USB serial. The board
# ships with only the RP2040 ROM bootloader, so Klipper goes at the "No
# bootloader" offset (RPXXXX_FLASH_START_0100, the default) with the W25Q080
# second stage (also the default). Matches the board's own header in
# config/generic-bigtreetech-skr-pico-v1.0.cfg.
#
# Minimized with scripts/firmware/minimize_config.py. Everything else is a
# Kconfig default (12 MHz crystal, USBSERIAL), so only the architecture is
# listed.

CONFIG_MACH_RPXXXX=y
