# Preset: stm32f405_toolhead
#
# Toolchanger toolhead board - currently disconnected (see
# biokalico_extras/firmware_flash.md). Captured from a known-good root
# .config; no bootloader offset (STM32_FLASH_START_0000 - Katapult is not
# used on this board, unlike stm32h743_mainboard/rp2040_nitehawk_sb).
# Minimized with scripts/firmware/minimize_config.py - values not listed
# here are Kconfig defaults, not deliberate choices (e.g. the peripheral
# WANT_* drivers are all enabled by default and are not board-specific
# selections).

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F405=y
CONFIG_STM32_FLASH_START_0000=y
CONFIG_STM32_CLOCK_REF_INTERNAL=y
