# Preset: stm32f405_toolhead
#
# Toolchanger toolhead board (STM32F405, internal clock, USB on PA11/PA12).
# Katapult as a first-stage bootloader at a 32KiB application-start offset
# (STM32_FLASH_START_8000 -> 0x8008000).
#
# Minimized with scripts/firmware/minimize_config.py. The 32KiB offset is
# also the STM32F405 default; it is listed anyway because a wrong offset
# overwrites Katapult.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F405=y
CONFIG_STM32_FLASH_START_8000=y
CONFIG_STM32_CLOCK_REF_INTERNAL=y
