# Preset: stm32g0b1_ebb36
#
# BIGTREETECH EBB36 CAN V1.2 (STM32G0B1, 8 MHz crystal), connected over its
# USB-C port rather than CAN. No bootloader offset (STM32_FLASH_START_0000):
# the board has no Katapult, so it is flashed through the chip's built-in
# DFU mode. A board that runs Klipper enters DFU on request; one that does
# not (new, or with broken firmware) is put there by hand with BOOT/RESET -
# see "Flashing by hand in DFU mode" in biokalico_extras/firmware_flash.md.
#
# Minimized with scripts/firmware/minimize_config.py. The 8 MHz clock
# reference and USB on PA11/PA12 are the STM32G0B1 defaults, so they are
# not listed.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32G0B1=y
CONFIG_STM32_FLASH_START_0000=y
