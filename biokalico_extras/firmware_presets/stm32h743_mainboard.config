# Preset: stm32h743_mainboard
#
# LDO Leviathan V1.3 mainboard (STM32H743). Confirmed via LDO's own guide
# (https://ldomotion.com/guides/voron-leviathan-v1-3) and the user: Katapult
# is flashed as a first-stage bootloader at a 128KiB application-start
# offset (STM32_FLASH_START_20000 -> 0x8020000). Getting this offset wrong
# would flash over Katapult - see biokalico_extras/firmware_flash.md.
#
# 25 MHz crystal, USB (PA11/PA12) - matches this printer's [mcu] serial
# connection (printer.cfg's header comment says "V1.1"; that label is
# stale/copy-pasted - the chip is H743, which is the V1.3 revision).
#
# Minimized with scripts/firmware/minimize_config.py.

CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H743=y
CONFIG_STM32_FLASH_START_20000=y
CONFIG_STM32_CLOCK_REF_25M=y
